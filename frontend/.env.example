# Optional shared preview account, prefilled on the login form only.
# VITE_ values are visible in the browser. Use only an intended demo account;
# never configure a personal password or a service/API credential here.
# Keep actual values in the ignored frontend/.env.local on the preview server.
# The login value may be an email or an APP_LOGIN_ALIAS configured on the API.
VITE_DEFAULT_LOGIN_EMAIL=
VITE_DEFAULT_LOGIN_PASSWORD=
# sse (default); poll delivers real incremental model chunks through buffering
# preview tunnels. Poll mode requires a single API worker or sticky routing.
VITE_CHAT_TRANSPORT=sse

