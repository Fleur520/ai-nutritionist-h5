# Deployment target. This address must be configured on the actual server.
APP_BIND_IP=172.16.10.3
APP_PORT=18080
DEPLOY_DATA_DIR=/data_1/ai-nutritionist-h5/data
APP_ALLOWED_ORIGIN=http://172.16.10.3:18080
# LAN HTTP only. For public deployment configure HTTPS then set true.
APP_COOKIE_SECURE=false
APP_MAX_AI_CONCURRENCY=10
APP_MAX_IMAGE_CONCURRENCY=4
APP_IMAGE_MAX_EDGE=1536
DEMO_MODE=false

# Database. Production uses the existing MySQL service and a dedicated database.
APP_DB_ENGINE=mysql
MYSQL_HOST=172.16.10.3
MYSQL_PORT=3306
MYSQL_DATABASE=ai_nutritionist_h5
MYSQL_USER=root
MYSQL_PASSWORD=

# OpenAI-compatible gateway; keep these credentials on the server only.
LLM_BASE_URL=http://172.16.10.3:9000/v1
LLM_API_KEY=
LLM_MODEL=Qwen3.8-27B

# Optional image/build overrides for servers with cached images or a PyPI mirror.
PYTHON_IMAGE=python:3.11-slim
NODE_IMAGE=node:22-alpine
PIP_INDEX_URL=https://pypi.org/simple
# Reports require a separately configured BiSheng workflow.
VITE_REPORTS_ENABLED=false
APP_REPORTS_ENABLED=false

# Text consultation: directly to vLLM / Qwen OpenAI-compatible API.
VLLM_CHAT_COMPLETIONS_URL=
VLLM_API_KEY=
# Exact --served-model-name reported by your instance
VLLM_MODEL=Qwen3.8-27B
VLLM_MAX_TOKENS=768

# Multimodal food recognition: can reuse text instance if vision is enabled.
VLLM_VISION_URL=
VLLM_VISION_MODEL=
VLLM_VISION_API_KEY=
# Qwen thinking can exhaust the output budget before emitting the food JSON.
VLLM_VISION_ENABLE_THINKING=false
VLLM_VISION_MAX_TOKENS=1536

# Image recognition provider. Switch to bisheng only after workflow acceptance.
# Generic consultation and optional reports keep their existing providers.
FOOD_RECOGNITION_PROVIDER=direct
BISHENG_RECOGNITION_BASE_URL=http://172.16.10.4:7860
BISHENG_RECOGNITION_WORKFLOW_ID=
# Optional gateway credential; the built-in open API can use its default operator.
BISHENG_RECOGNITION_API_KEY=
# Live acceptance uses input; some OpenAPI documents display the Python name user_input.
BISHENG_RECOGNITION_INPUT_FIELD=input
BISHENG_RECOGNITION_IMAGE_KEY=meal_image
BISHENG_RECOGNITION_TIMEOUT=240

# BiSheng 1.3.1 reporting workflow ONLY. E.g. http://<bisheng-host>:7860/api/v2/workflow/invoke
# Verify the actual published address and workflow UUID on YOUR deployment.
BISHENG_REPORT_URL=
BISHENG_REPORT_WORKFLOW_ID=
# v1.3.1 open API may use default_operator rather than Bearer auth; only fill if your gateway requires it.
BISHENG_REPORT_API_KEY=
# Used only if workflow's input event omits the input node's form schema.
BISHENG_REPORT_INPUT_KEY=report_context
